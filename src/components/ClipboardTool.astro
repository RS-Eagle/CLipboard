---
---
<div class="max-w-3xl mx-auto w-full bg-white/90 dark:bg-slate-800/90 rounded-2xl shadow-xl p-5 md:p-6 mt-3 border border-slate-200 dark:border-slate-700">
  
  <div aria-live="polite" id="status-message" class="text-center font-medium text-red-600 dark:text-red-400 mb-4 h-6"></div>

  <div id="state-paste" class="">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-5">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Paste your text</h2>
      
      <button id="btn-show-receive" class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-amber-700 bg-amber-50 border border-amber-200 hover:bg-amber-100 dark:text-amber-300 dark:bg-amber-900/30 dark:border-amber-800 dark:hover:bg-amber-900/50 rounded-xl transition-all w-full sm:w-auto shadow-sm active:scale-95">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
        </svg>
        Have a code? Enter it here
      </button>
    </div>
    
    <textarea id="text-input" class="w-full h-32 md:h-40 p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 focus:ring-2 focus:ring-amber-500 outline-none resize-y mb-2" placeholder="Paste text, links, notes, code, or anything else you want to transfer..."></textarea>
    
    <div class="flex justify-between text-sm text-slate-500 mb-6">
      <span>Words: <span id="word-count">0</span></span>
      <span>Characters: <span id="char-count">0</span></span>
    </div>
    
    <button id="btn-generate" class="w-full py-3 px-6 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl font-semibold transition-colors disabled:opacity-50">
      Generate Code
    </button>
  </div>

  <div id="state-code" class="hidden-state text-center py-8">
    <h2 class="text-xl font-semibold mb-2">Your Code</h2>
    <p class="text-slate-600 dark:text-slate-400 mb-6">Enter this code on your other device to retrieve your text.</p>
    
    <div class="text-6xl md:text-8xl font-bold tracking-widest text-amber-600 dark:text-amber-400 mb-6 font-mono" id="display-code">
      ------
    </div>
    
    <p class="text-sm text-amber-600 dark:text-amber-400 mb-8 font-medium">
      <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Expires in 10 minutes (One-time retrieval)
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button id="btn-copy-code" class="py-3 px-6 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-900 dark:text-white rounded-xl font-semibold transition-colors">
        Copy Code
      </button>
      <button id="btn-reset-from-code" class="py-3 px-6 bg-transparent border-2 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 rounded-xl font-semibold transition-colors">
        Start Over
      </button>
    </div>
  </div>

  <div id="state-receive" class="hidden-state text-center py-8">
    <h2 class="text-xl font-semibold mb-2">Enter Code</h2>
    <p class="text-slate-600 dark:text-slate-400 mb-8">Enter the 6-digit code shown on your other device.</p>
    
    <input type="text" id="code-input" maxlength="6" class="text-center text-4xl tracking-[0.5em] font-mono w-full max-w-xs mx-auto p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 focus:ring-2 focus:ring-amber-500 outline-none mb-8" placeholder="------" />
    
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button id="btn-retrieve" class="py-3 px-8 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl font-semibold transition-colors disabled:opacity-50">
        Get Text
      </button>
      <button id="btn-cancel-receive" class="py-3 px-6 bg-transparent border-2 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 rounded-xl font-semibold transition-colors">
        Cancel
      </button>
    </div>
  </div>

  <div id="state-result" class="hidden-state">
    <h2 class="text-xl font-semibold mb-4 text-center">Text Ready to Copy</h2>
    <div class="p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 mb-6 h-48 md:h-64 overflow-y-auto whitespace-pre-wrap font-sans" id="display-text"></div>
    
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button id="btn-copy-text" class="py-3 px-8 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl font-semibold transition-colors">
        Copy Text
      </button>
      <button id="btn-reset-from-result" class="py-3 px-6 bg-transparent border-2 border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 rounded-xl font-semibold transition-colors">
        Transfer Another
      </button>
    </div>
  </div>
</div>

<script>
  // DOM Elements
  const states = {
    paste: document.getElementById('state-paste'),
    code: document.getElementById('state-code'),
    receive: document.getElementById('state-receive'),
    result: document.getElementById('state-result')
  };
  
  const els = {
    textInput: document.getElementById('text-input') as HTMLTextAreaElement,
    wordCount: document.getElementById('word-count'),
    charCount: document.getElementById('char-count'),
    btnGenerate: document.getElementById('btn-generate') as HTMLButtonElement,
    btnShowReceive: document.getElementById('btn-show-receive'),
    displayCode: document.getElementById('display-code'),
    btnCopyCode: document.getElementById('btn-copy-code'),
    btnResetCode: document.getElementById('btn-reset-from-code'),
    codeInput: document.getElementById('code-input') as HTMLInputElement,
    btnRetrieve: document.getElementById('btn-retrieve') as HTMLButtonElement,
    btnCancelReceive: document.getElementById('btn-cancel-receive'),
    displayText: document.getElementById('display-text'),
    btnCopyText: document.getElementById('btn-copy-text'),
    btnResetResult: document.getElementById('btn-reset-from-result'),
    status: document.getElementById('status-message')
  };

  let currentCode = '';
  let retrievedText = '';

  // Utility
  const showState = (stateName: keyof typeof states) => {
    Object.values(states).forEach(el => el?.classList.add('hidden-state'));
    states[stateName]?.classList.remove('hidden-state');
    els.status!.textContent = '';
  };
  const setStatus = (msg: string) => { els.status!.textContent = msg; };

  // Listeners: Paste State
  els.textInput?.addEventListener('input', () => {
    const text = els.textInput.value;
    els.charCount!.textContent = text.length.toString();
    els.wordCount!.textContent = (text.match(/\S+/g) || []).length.toString();
  });

  els.btnShowReceive?.addEventListener('click', () => showState('receive'));

  els.btnGenerate?.addEventListener('click', async () => {
    const content = els.textInput.value.trim();
    if (!content) return setStatus('Please paste some text first.');
    if (content.length > 20000) return setStatus('Text is too long (Max 20,000 chars).');

    els.btnGenerate.disabled = true;
    els.btnGenerate.textContent = 'Generating...';
    
    try {
      const res = await fetch('/api/clipboard/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
      });
      const data = await res.json();
      
      if (res.ok) {
        currentCode = data.code;
        els.displayCode!.textContent = data.code;
        showState('code');
        els.textInput.value = '';
        els.charCount!.textContent = '0';
        els.wordCount!.textContent = '0';
      } else {
        setStatus(data.error || 'Something went wrong.');
      }
    } catch (err) {
      setStatus('Network error. Please try again.');
    } finally {
      els.btnGenerate.disabled = false;
      els.btnGenerate.textContent = 'Generate Code';
    }
  });

  // Listeners: Code State
  els.btnCopyCode?.addEventListener('click', () => {
    navigator.clipboard.writeText(currentCode).then(() => {
      const orig = els.btnCopyCode!.textContent;
      els.btnCopyCode!.textContent = 'Copied!';
      setTimeout(() => els.btnCopyCode!.textContent = orig, 2000);
    }).catch(() => setStatus('Failed to copy.'));
  });
  els.btnResetCode?.addEventListener('click', () => showState('paste'));

  // Listeners: Receive State
  els.btnCancelReceive?.addEventListener('click', () => showState('paste'));
  
  els.btnRetrieve?.addEventListener('click', async () => {
    const code = els.codeInput.value.trim();
    if (!/^\d{6}$/.test(code)) return setStatus('Please enter a valid 6-digit code.');

    els.btnRetrieve.disabled = true;
    els.btnRetrieve.textContent = 'Retrieving...';

    try {
      const res = await fetch('/api/clipboard/retrieve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const data = await res.json();

      if (res.ok) {
        retrievedText = data.content;
        els.displayText!.textContent = retrievedText;
        showState('result');
        els.codeInput.value = '';
      } else {
        setStatus(data.error || 'Something went wrong.');
      }
    } catch (err) {
      setStatus('Network error. Please try again.');
    } finally {
      els.btnRetrieve.disabled = false;
      els.btnRetrieve.textContent = 'Get Text';
    }
  });

  // Listeners: Result State
  els.btnCopyText?.addEventListener('click', () => {
    navigator.clipboard.writeText(retrievedText).then(() => {
      const orig = els.btnCopyText!.textContent;
      els.btnCopyText!.textContent = 'Copied!';
      setTimeout(() => els.btnCopyText!.textContent = orig, 2000);
    }).catch(() => setStatus('Failed to copy text.'));
  });
  els.btnResetResult?.addEventListener('click', () => showState('paste'));
</script>