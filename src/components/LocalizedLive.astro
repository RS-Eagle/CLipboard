---
import Layout from '../layouts/Layout.astro';
import LiveClipboardTool from './LiveClipboardTool.astro';
import LanguagePicker from './LanguagePicker.astro';

export type SupportedLanguage = 'es' | 'ja' | 'fr' | 'de' | 'pt' | 'ko' | 'it';

const content: Record<SupportedLanguage, {
  title: string;
  description: string;
  heading: string;
  intro: string;
  howTitle: string;
  steps: [string, string, string, string];
  highlightsTitle: string;
  highlights: string[];
  aboutTitle: string;
  aboutText: string;
  faqTitle: string;
  questions: [string, string][];
}> = {
  es: {
    title: 'Portapapeles en vivo – Sincronizar texto entre dispositivos',
    description: 'Sincroniza el portapapeles entre tu teléfono, ordenador y tableta en tiempo real. Pega o edita texto y mira cómo se actualiza automáticamente.',
    heading: 'Portapapeles en vivo',
    intro: 'Mantén tu portapapeles sincronizado entre tus dispositivos en tiempo real.',
    howTitle: 'Cómo funciona el portapapeles en vivo',
    steps: [
      'Haz clic en "Iniciar portapapeles en vivo" para crear una sesión con un código de 6 dígitos.',
      'Abre esta misma página en tu móvil, portátil o tableta e introduce el código.',
      'Escribe notas, pega enlaces o edita texto en cualquiera de las pantallas.',
      'Los cambios se sincronizan al instante en los dispositivos conectados sin recargar la página.'
    ],
    highlightsTitle: 'Características principales',
    highlights: [
      'Sincronización bidireccional en tiempo real entre móvil y ordenador.',
      'Reconexión automática si se interrumpe la conexión o cambias de pestaña.',
      'El contenido más reciente siempre se recupera al reconectarte.',
      'Sin registro, sin contraseña y sin necesidad de instalar aplicaciones.'
    ],
    aboutTitle: 'Sincronización de portapapeles en tiempo real sin aplicaciones',
    aboutText: 'El portapapeles en vivo te permite transferir texto de forma continua entre varios dispositivos. Ya sea que estés copiando enlaces desde el PC al móvil o editando notas en tiempo real, todo se sincroniza al instante a través de tu navegador.',
    faqTitle: 'Preguntas frecuentes sobre el portapapeles en vivo',
    questions: [
      ['¿En qué se diferencia del portapapeles estándar?', 'El portapapeles estándar transfiere texto una sola vez mediante un código de un solo uso. El portapapeles en vivo mantiene una conexión continua donde cualquier cambio se sincroniza en tiempo real.'],
      ['¿Qué sucede si mi dispositivo se apaga o pierde el Wi-Fi?', 'El portapapeles en vivo cuenta con reconexión automática. Cuando recuperes la conexión, se vuelve a suscribir y carga el último texto guardado.'],
      ['¿Puedo conectar varios dispositivos al mismo tiempo?', 'Sí. Cualquier dispositivo que introduzca el código de 6 dígitos se unirá a la misma sesión de sincronización en vivo.']
    ]
  },
  ja: {
    title: 'ライブクリップボード – デバイス間リアルタイムテキスト同期',
    description: 'スマートフォン、パソコン、タブレット間でクリップボードをリアルタイム同期。入力や編集が接続したデバイスに自動反映されます。',
    heading: 'ライブクリップボード',
    intro: 'デバイス間でクリップボードをリアルタイム同期。',
    howTitle: 'ライブクリップボードの使い方',
    steps: [
      '「ライブセッションを開始」をクリックして6桁のコードを生成します。',
      'スマートフォンや別のパソコンで同じページを開き、コードを入力します。',
      'どちらの画面からでもテキストやリンクを入力・貼り付けできます。',
      '手動で再読み込みすることなく、接続デバイスに即座に変更が同期されます。'
    ],
    highlightsTitle: '主な特長',
    highlights: [
      'スマートフォンとパソコンの双方向リアルタイム同期。',
      'タブ切り替えやWi-Fi切断時も自動で再接続。',
      '最新テキストが保持されるため、再接続時も復元可能。',
      'アカウント登録不要、アプリのインストールも不要。'
    ],
    aboutTitle: 'アプリ不要でデバイス間テキストを瞬時に同期',
    aboutText: 'ライブクリップボードなら、自分宛てにメッセージを送ったりメールしたりする手間なく、PCとスマホの間でテキストをリアルタイムに共有できます。ブラウザだけで快適に動作します。',
    faqTitle: 'よくある質問',
    questions: [
      ['通常のクリップボードとの違いは何ですか？', '通常のクリップボードは1回限りのコード転送ですが、ライブクリップボードは接続を維持し、リアルタイムに変更を同期します。'],
      ['デバイスがスリープしたり回線が切れたらどうなりますか？', '復帰時に自動で再接続が行われ、最新の保存状態が自動的に復元されます。'],
      ['複数の端末を同時に接続できますか？', 'はい。6桁のコードを入力すれば、複数のデバイスから同じセッションに接続可能です。']
    ]
  },
  fr: {
    title: 'Presse-papiers en direct – Synchroniser du texte entre appareils',
    description: 'Synchronisez votre presse-papiers entre votre téléphone, ordinateur et tablette en temps réel. Les modifications apparaissent instantanément sur vos appareils.',
    heading: 'Presse-papiers en direct',
    intro: 'Gardez votre presse-papiers synchronisé entre vos appareils en temps réel.',
    howTitle: 'Comment fonctionne le presse-papiers en direct',
    steps: [
      'Cliquez sur "Démarrer le presse-papiers en direct" pour obtenir un code à 6 chiffres.',
      'Ouvrez cette même page sur votre autre appareil et saisissez le code.',
      'Rédigez ou collez du texte, des notes ou des liens sur l’un ou l’autre des écrans.',
      'Les modifications apparaissent instantanément sans recharger la page.'
    ],
    highlightsTitle: 'Points forts',
    highlights: [
      'Synchronisation bidirectionnelle instantanée entre téléphone et PC.',
      'Reconnexion automatique en cas de mise en veille ou de coupure réseau.',
      'Le texte le plus récent est conservé et restauré à la reconnexion.',
      'Sans compte, sans mot de passe et sans installation d’application.'
    ],
    aboutTitle: 'Synchronisation en direct sans aucune application',
    aboutText: 'Le presse-papiers en direct permet de maintenir une liaison active entre vos différents appareils. Transférez des URL, des notes de réunion ou du code instantanément entre votre ordinateur et votre smartphone.',
    faqTitle: 'Foire aux questions',
    questions: [
      ['Quelle est la différence avec le presse-papiers classique ?', 'Le presse-papiers classique effectue un transfert unique via un code. Le presse-papiers en direct maintient une connexion continue en temps réel.'],
      ['Que se passe-t-il si mon appareil se met en veille ?', 'La page gère la reconnexion automatique. Dès votre retour, la session est rétablie et le texte à jour est récupéré.'],
      ['Plusieurs appareils peuvent-ils rejoindre la même session ?', 'Oui, tous les appareils munis du code à 6 chiffres peuvent participer à la même session.']
    ]
  },
  de: {
    title: 'Live-Zwischenablage – Text in Echtzeit zwischen Geräten synchronisieren',
    description: 'Synchronisieren Sie Ihre Zwischenablage in Echtzeit zwischen Smartphone, Computer und Tablet. Änderungen werden sofort auf beiden Bildschirmen übernommen.',
    heading: 'Live-Zwischenablage',
    intro: 'Halten Sie Ihre Zwischenablage in Echtzeit zwischen Ihren Geräten synchron.',
    howTitle: 'So funktioniert die Live-Zwischenablage',
    steps: [
      'Klicken Sie auf "Live-Zwischenablage starten", um einen 6-stelligen Code zu erstellen.',
      'Öffnen Sie diese Seite auf Ihrem anderen Gerät und geben Sie den Code ein.',
      'Geben Sie Notizen, Links oder Text auf einem der Bildschirme ein.',
      'Änderungen werden sofort und ohne Neuladen auf dem anderen Gerät sichtbar.'
    ],
    highlightsTitle: 'Wichtige Funktionen',
    highlights: [
      'Zwei-Wege-Synchronisation in Echtzeit zwischen PC und Smartphone.',
      'Automatische Wiederverbindung bei Verbindungsabbrüchen oder Inaktivität.',
      'Der aktuellste Text wird gespeichert und beim Wiederverbinden wiederhergestellt.',
      'Kein Konto, kein Passwort und keine App-Installation erforderlich.'
    ],
    aboutTitle: 'Echtzeit-Textübertragung ohne Installation',
    aboutText: 'Mit der Live-Zwischenablage übertragen Sie Texte, Adressen und URLs nahtlos zwischen Desktop und Mobilgerät. Keine E-Mails an sich selbst mehr nötig.',
    faqTitle: 'Häufig gestellte Fragen',
    questions: [
      ['Wie unterscheidet sich die Live-Zwischenablage von der Standard-Zwischenablage?', 'Die Standard-Zwischenablage überträgt Text einmalig per Code. Die Live-Zwischenablage bleibt verbunden und synchronisiert Änderungen laufend in Echtzeit.'],
      ['Was passiert bei Verbindungsverlust oder Standby?', 'Die Verbindung wird automatisch wieder aufgebaut, sobald Sie zurückkehren, und der aktuellste Text wird geladen.'],
      ['Können mehrere Geräte dieselbe Sitzung nutzen?', 'Ja, jedes Gerät mit dem 6-stelligen Sitzungscode kann der Live-Sitzung beitreten.']
    ]
  },
  pt: {
    title: 'Área de transferência ao vivo – Sincronizar texto entre dispositivos',
    description: 'Mantenha sua área de transferência sincronizada entre celular, computador e tablet em tempo real. As edições aparecem instantaneamente.',
    heading: 'Área de transferência ao vivo',
    intro: 'Mantenha sua área de transferência sincronizada entre seus dispositivos em tempo real.',
    howTitle: 'Como funciona a área de transferência ao vivo',
    steps: [
      'Clique em "Iniciar área ao vivo" para gerar um código de 6 dígitos.',
      'Abra esta mesma página no seu celular ou computador e digite o código.',
      'Digite notas, cole links ou edite o texto em qualquer uma das telas.',
      'As alterações aparecem automaticamente sem necessidade de atualizar.'
    ],
    highlightsTitle: 'Principais recursos',
    highlights: [
      'Sincronização bidirecional em tempo real entre celular e computador.',
      'Reconexão automática caso a internet caia ou você mude de aba.',
      'O conteúdo mais recente é salvo e recuperado ao reconectar.',
      'Sem cadastro, sem senha e sem necessidade de baixar aplicativos.'
    ],
    aboutTitle: 'Sincronização em tempo real direto no navegador',
    aboutText: 'A área de transferência ao vivo elimina a necessidade de enviar mensagens para si mesmo. Conecte seu celular e seu computador em segundos e compartilhe texto instantaneamente.',
    faqTitle: 'Perguntas frequentes',
    questions: [
      ['Qual é a diferença para a área de transferência normal?', 'A área de transferência normal faz uma transferência única. A versão ao vivo mantém os aparelhos conectados em tempo real.'],
      ['O que acontece se meu celular suspender?', 'Ao voltar para a página, a conexão se restabelece automaticamente e busca a versão mais recente do texto.'],
      ['Posso conectar mais de dois aparelhos?', 'Sim. Qualquer dispositivo com o código de 6 dígitos pode participar da mesma sessão ao vivo.']
    ]
  },
  ko: {
    title: '라이브 클립보드 – 기기 간 실시간 텍스트 동기화',
    description: '휴대폰, 컴퓨터, 태블릿 간에 클립보드를 실시간으로 동기화하세요. 한 화면에서 입력한 텍스트가 다른 기기에 즉시 반영됩니다.',
    heading: '라이브 클립보드',
    intro: '기기 간에 클립보드를 실시간으로 동기화하세요.',
    howTitle: '라이브 클립보드 작동 방식',
    steps: [
      '"라이브 클립보드 시작"을 눌러 6자리 세션 코드를 생성합니다.',
      '다른 기기에서 이 페이지를 열고 6자리 코드를 입력합니다.',
      '어느 기기에서든 텍스트를 입력하거나 링크를 붙여넣으세요.',
      '새로고침 없이 실시간으로 다른 기기 화면에 변경 사항이 표시됩니다.'
    ],
    highlightsTitle: '주요 특징',
    highlights: [
      '휴대폰과 PC 간의 양방향 실시간 동기화.',
      '네트워크 끊김 또는 화면 전환 시 자동 재연결 지원.',
      '최신 텍스트가 자동 저장되어 재연결 시 안전하게 복구.',
      '앱 설치나 계정 생성 없이 브라우저에서 바로 사용 가능.'
    ],
    aboutTitle: '앱 설치 없이 브라우저에서 바로 실시간 동기화',
    aboutText: '라이브 클립보드는 기기 간에 텍스트를 실시간으로 주고받는 가장 빠른 방법입니다. 스스로에게 이메일을 보내거나 메신저를 열 필요 없이 브라우저만으로 즉시 동기화됩니다.',
    faqTitle: '자주 묻는 질문',
    questions: [
      ['일반 클립보드와 어떻게 다른가요?', '일반 클립보드는 일회성 코드 전송 방식인 반면, 라이브 클립보드는 기기 간 연결을 유지하며 실시간으로 텍스트 변경 사항을 동기화합니다.'],
      ['기기가 절전 모드로 들어가거나 인터넷이 끊기면 어떻게 되나요?', '기기가 다시 활성화되면 자동으로 재연결을 시도하며, 서버에 저장된 최신 텍스트를 불러옵니다.'],
      ['여러 기기를 동시에 연결할 수 있나요?', '네, 6자리 세션 코드만 있으면 여러 기기에서 동시에 실시간으로 협업할 수 있습니다.']
    ]
  },
  it: {
    title: 'Appunti live – Sincronizza testo tra dispositivi in tempo reale',
    description: 'Sincronizza gli appunti tra smartphone, computer e tablet in tempo reale. Le modifiche appaiono istantaneamente su tutti i dispositivi collegati.',
    heading: 'Appunti live',
    intro: 'Mantieni i tuoi appunti sincronizzati tra i tuoi dispositivi in tempo reale.',
    howTitle: 'Come funzionano gli appunti live',
    steps: [
      'Fai clic su "Avvia appunti live" per creare una sessione con codice a 6 cifre.',
      'Apri la stessa pagina sul tuo altro dispositivo e inserisci il codice.',
      'Digita o incolla note, link o frammenti di codice su qualsiasi schermo.',
      'Le modifiche appaiono all’istante senza bisogno di ricaricare la pagina.'
    ],
    highlightsTitle: 'Caratteristiche principali',
    highlights: [
      'Sincronizzazione bidirezionale in tempo reale tra smartphone e PC.',
      'Riconnessione automatica in caso di standby o disconnessione.',
      'Il testo più recente viene salvato e recuperato alla riconnessione.',
      'Nessun account, nessuna password e nessuna app da installare.'
    ],
    aboutTitle: 'Sincronizzazione in tempo reale senza installare app',
    aboutText: 'Gli appunti live ti consentono di mantenere sincronizzati telefono e computer senza inviarti e-mail o messaggi. Tutto avviene direttamente nel browser con la massima rapidità.',
    faqTitle: 'Domande frequenti',
    questions: [
      ['In cosa differisce dagli appunti standard?', 'Gli appunti standard trasferiscono il testo una sola volta con codice temporaneo. Gli appunti live mantengono la connessione attiva in tempo reale.'],
      ['Cosa succede se il dispositivo va in standby?', 'La riconnessione avviene automaticamente al ripristino della sessione, recuperando il testo più aggiornato.'],
      ['Posso connettere più dispositivi contemporaneamente?', 'Sì, chiunque disponga del codice a 6 cifre può partecipare alla stessa sessione.']
    ]
  }
};

const { lang } = Astro.props as { lang: SupportedLanguage };
const page = content[lang] || content.es;
---

<Layout 
  title={page.title} 
  description={page.description} 
  lang={lang}
  pagePath="live"
>
  <header class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center border-b border-slate-200 dark:border-slate-800">
    <a href={`/${lang}/`} class="inline-flex items-center gap-3 font-bold text-xl tracking-tight text-slate-900 dark:text-white" aria-label="Online Copy Paste">
      <img src="/online-copy-paste-logo.svg" alt="" width="40" height="40" />
      <span class="hidden md:block">Online Copy Paste</span>
    </a>
    <nav class="flex items-center gap-4 md:gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href={`/${lang}/`} class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Standard</a>
      <a href="#how-it-works" class="hidden md:block hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Info</a>
      <a href="#faq" class="hidden md:block hover:text-amber-600 dark:hover:text-amber-400 transition-colors">FAQ</a>
      <LanguagePicker currentPath="live" />
      <button id="localized-theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Toggle light and dark mode" class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-300 bg-white text-slate-700 shadow-sm hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 transition-colors">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-8 md:py-12">
    <!-- HERO SECTION -->
    <section class="text-center mb-10 rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-100 via-white to-amber-50 dark:from-[#111318] dark:via-[#07090d] dark:to-[#17120b] px-4 py-6 md:px-6 md:py-8" id="top">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3 tracking-tight text-slate-900 dark:text-white">{page.heading}</h1>
      <p class="text-base text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-4">{page.intro}</p>
      
      <!-- LIVE TOOL COMPONENT -->
      <LiveClipboardTool lang={lang} />
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mt-20 pt-10 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-slate-900 dark:text-white">{page.howTitle}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {page.steps.map((step, idx) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
            <div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 rounded-full flex items-center justify-center font-bold mx-auto mb-4">{idx + 1}</div>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{step}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- HIGHLIGHTS / FEATURES -->
    <section id="features" class="mt-20">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-slate-900 dark:text-white">{page.highlightsTitle}</h2>
      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {page.highlights.map((item) => (
          <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-sm leading-relaxed flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="mt-20 max-w-3xl mx-auto prose prose-slate dark:prose-invert prose-lg">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-4">{page.aboutTitle}</h2>
      <p>{page.aboutText}</p>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mt-20 max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 text-slate-900 dark:text-white">{page.faqTitle}</h2>
      <div class="space-y-4">
        {page.questions.map(([q, a]) => (
          <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
              {q}
              <span class="transition group-open:rotate-180">
                <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 mt-20 px-6 py-10 text-center">
    <div class="max-w-5xl mx-auto">
      <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">Online Copy Paste – Live Clipboard</p>
      <LanguagePicker currentPath="live" />
    </div>
  </footer>
</Layout>

<script is:inline>
  const themeToggle = document.getElementById('localized-theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
