---
import Layout from '../layouts/Layout.astro';
import LiveClipboardTool from '../components/LiveClipboardTool.astro';
import LanguagePicker from '../components/LanguagePicker.astro';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://onlinecopypaste.com').replace(/\/$/, '');

// Structured Data for SEO
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Live Clipboard – Online Copy Paste",
      "url": `${siteUrl}/live`,
      "description": "Sync clipboard text between your phone, laptop, and tablet in real time. Instant QR code pairing, direct link sharing, and sub-second bi-directional synchronization.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Works across all modern web browsers.",
      "featureList": [
        "Real-time bi-directional clipboard sync",
        "Instant QR code pairing for smartphone cameras",
        "Direct link sharing with copy link",
        "Dedicated copy code and copy text buttons",
        "Scalable high-contrast QR code display",
        "Automatic reconnection with state recovery",
        "Zero registration, accounts, or downloads required",
        "Secure end-to-end HTTPS encrypted transmission"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Live Clipboard and how does it work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Live Clipboard connects two or more devices together in a private, real-time synchronization room. When you type or paste text, links, or code on one screen, it appears instantaneously on all connected devices without refreshing."
          }
        },
        {
          "@type": "Question",
          "name": "How does the QR code live pairing work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When you start a Live Clipboard session, a dynamic, high-contrast QR code is automatically generated. Simply point your smartphone camera or iPad at the QR code to open the session directly. You can also click the QR code thumbnail to zoom into full-screen scan mode."
          }
        },
        {
          "@type": "Question",
          "name": "How do I copy the session link or text to my clipboard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The session header includes dedicated quick-action buttons: 'Copy Link' copies the full invite URL (including session parameter), 'Copy Code' copies the 6-digit session PIN, and 'Copy Text' copies the current room's live text straight to your operating system clipboard with a single click."
          }
        },
        {
          "@type": "Question",
          "name": "How is Live Clipboard different from the standard clipboard tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The standard clipboard tool creates a one-time snapshot of text that can be retrieved once using a 6-digit code. Live Clipboard maintains an active, continuous two-way connection where edits made on either device update across all connected devices in real time."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if my phone screen locks or Wi-Fi drops?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Live Clipboard features automatic heartbeat reconnection. When you unlock your device, switch back to the browser tab, or recover your internet connection, the tool automatically reconnects and synchronizes the latest saved text state."
          }
        },
        {
          "@type": "Question",
          "name": "Can multiple devices connect to the same session simultaneously?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Anyone who scans the session QR code, clicks the shared direct link, or enters the 6-digit PIN can participate in the same live session, making it ideal for multi-monitor setups, tablet-desktop workflows, and quick cross-room team sharing."
          }
        },
        {
          "@type": "Question",
          "name": "Is my text private, secure, and encrypted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All data transfers use industry-standard TLS/HTTPS encryption in transit. Sessions are identified by randomized PINs, operate ephemerally, and are automatically discarded after inactivity without long-term tracking or selling of your data."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title="Live Clipboard – Real-Time Clipboard Sync Between Phone and PC"
  description="Sync your clipboard between your phone, computer, and tablet in real time with instant QR code pairing, direct link sharing, and sub-second bi-directional text sync."
  lang="en"
  pagePath="live"
>
  <!-- Inject Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- HEADER -->
  <header class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center border-b border-slate-200 dark:border-slate-800">
    <a href="/" class="inline-flex items-center gap-3 font-bold text-xl tracking-tight text-slate-900 dark:text-white" aria-label="Online Copy Paste home">
      <img src="/online-copy-paste-logo.svg" alt="" width="40" height="40" />
      <span class="hidden md:block">Online Copy Paste</span>
    </a>
    <nav class="flex items-center gap-4 md:gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="/" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Standard Clipboard</a>
      <a href="#how-it-works" class="hidden md:block hover:text-amber-600 dark:hover:text-amber-400 transition-colors">How It Works</a>
      <a href="#features" class="hidden md:block hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Features</a>
      <a href="#faq" class="hidden md:block hover:text-amber-600 dark:hover:text-amber-400 transition-colors">FAQ</a>
      <LanguagePicker currentPath="live" />
      <button id="theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Toggle light and dark mode" class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-300 bg-white text-slate-700 shadow-sm hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 transition-colors">
        <!-- Sun Icon (shows in dark mode) -->
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
        </svg>
        <!-- Moon Icon (shows in light mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-8 md:py-12">
    <!-- HERO SECTION -->
    <section class="text-center mb-10 rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-100 via-white to-amber-50 dark:from-[#111318] dark:via-[#07090d] dark:to-[#17120b] px-4 py-6 md:px-6 md:py-8 shadow-sm" id="top">
      <!-- Feature Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/40">
          ⚡ Real-Time 2-Way Sync
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
          📷 Instant QR Code Pairing
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40">
          🔗 Direct Link Sharing
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/40">
          🔒 Zero Accounts Required
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-3 tracking-tight text-slate-900 dark:text-white">
        Live Clipboard
      </h1>
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-2 font-medium">
        Keep your clipboard synchronized between your devices in real time.
      </p>
      <p class="text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-6">
        Paste or edit text on one screen and watch it automatically update on your connected phone, laptop, or tablet without manual page reloading.
      </p>

      <!-- LIVE TOOL COMPONENT -->
      <LiveClipboardTool lang="en" />
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mt-20 pt-10 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-3">
          How Live Clipboard Works
        </h2>
        <p class="text-sm md:text-base text-slate-600 dark:text-slate-400">
          Connect your desktop, mobile phone, and tablet in seconds with zero login or setup.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center text-center">
          <div class="w-12 h-12 bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 rounded-xl flex items-center justify-center font-bold text-lg mb-4 shadow-sm">
            1
          </div>
          <h3 class="text-base font-semibold mb-2 text-slate-900 dark:text-white">Start Session</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Click <strong>Start Live Clipboard</strong> to generate a unique 6-digit session PIN and high-contrast pairing QR code.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center text-center">
          <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 rounded-xl flex items-center justify-center font-bold text-lg mb-4 shadow-sm">
            2
          </div>
          <h3 class="text-base font-semibold mb-2 text-slate-900 dark:text-white">Scan or Share</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Scan the on-screen QR code with your phone camera, click <strong>Copy Link</strong> to send via chat, or enter the 6-digit code.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center text-center">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-xl flex items-center justify-center font-bold text-lg mb-4 shadow-sm">
            3
          </div>
          <h3 class="text-base font-semibold mb-2 text-slate-900 dark:text-white">Type or Paste</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Paste links, code snippets, notes, or messages on either screen. Everything is captured automatically.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center text-center">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300 rounded-xl flex items-center justify-center font-bold text-lg mb-4 shadow-sm">
            4
          </div>
          <h3 class="text-base font-semibold mb-2 text-slate-900 dark:text-white">Live Instant Sync</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Watch changes stream live across your devices with sub-second latency and click <strong>Copy Text</strong> to grab it instantly.
          </p>
        </div>
      </div>
    </section>

    <!-- KEY FEATURES -->
    <section id="features" class="mt-20 pt-10 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-3">
          Modern Real-Time Clipboard Features
        </h2>
        <p class="text-sm md:text-base text-slate-600 dark:text-slate-400">
          Engineered for maximum speed, bulletproof reliability, and zero cross-device friction.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-amber-300 dark:hover:border-amber-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Instant QR Code Pairing</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Eliminate manual typing. A crisp, scalable vector QR code is rendered directly in your session bar. Click to expand into a high-visibility modal for easy scanning across desks.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-emerald-300 dark:hover:border-emerald-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Direct Link & Code Sharing</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            One-click <strong>Copy Link</strong> instantly prepares a direct joining URL (<code class="text-xs bg-slate-100 dark:bg-slate-900 px-1 py-0.5 rounded text-amber-600 dark:text-amber-400">/live?session=XXXXXX</code>). Send it over chat or open it in a secondary browser window effortlessly.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-blue-300 dark:hover:border-blue-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Quick OS Clipboard Copy</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Don't waste time selecting all text and hitting hotkeys. Click the dedicated <strong>Copy Text</strong> button to transfer the active live session content straight to your operating system clipboard.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-purple-300 dark:hover:border-purple-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Resilient Auto-Reconnection</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Smart connection monitor automatically resumes session streaming if your smartphone locks, your tablet sleeps, or your Wi-Fi briefly disconnects. Your session state is preserved.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-sky-300 dark:hover:border-sky-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-sky-50 dark:bg-sky-900/40 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Universal Compatibility</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Runs natively in any standard web browser across Windows, macOS, Android (Chrome/Firefox/Samsung), iPhone & iPad (Safari/Chrome), and Linux with identical features and responsiveness.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:border-rose-300 dark:hover:border-rose-700/60 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-rose-50 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2">Privacy & Ephemeral Storage</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Zero account sign-up, no email registration, and no telemetry tracking of clipboard contents. Sessions are transient, private to your PIN, and automatically expire after inactivity.
          </p>
        </div>
      </div>
    </section>

    <!-- EXPLANATORY SEO CONTENT -->
    <section class="mt-20 max-w-4xl mx-auto prose prose-slate dark:prose-invert prose-lg">
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/50 p-8 md:p-12 shadow-sm space-y-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
            Real-Time Two-Way Clipboard Sync Across Any Device
          </h2>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            Moving text, website links, terminal commands, or drafts between computers and smartphones has historically been frustrating. Most people resort to sending messages to their own accounts on Slack, WhatsApp, or Telegram, emailing drafts to themselves, or installing intrusive third-party sync apps that require accounts, cloud syncing permissions, and background battery drain.
          </p>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            <strong>Live Clipboard</strong> reimagines cross-device productivity. It turns any web browser into an instant, continuous bridge. Simply open Live Clipboard on your desktop and scan the generated QR code with your phone camera. Both devices are linked immediately in a private room: whatever you type or paste on one device appears synchronously on the other with virtually zero latency.
          </p>
        </div>

        <div class="border-t border-slate-200 dark:border-slate-800 pt-8">
          <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">
            Instant QR Code Pairing: Effortless Desktop-to-Mobile Continuity
          </h3>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            No more manually typing URLs or session IDs on small phone keyboards. Live Clipboard generates a scalable vector QR code right on your session header:
          </p>
          <ul class="list-disc pl-6 space-y-2 text-slate-600 dark:text-slate-300">
            <li><strong>Scan With Native Camera:</strong> On iOS and Android, open your default camera app, point it at the QR code, and tap the notification banner to launch the session instantly.</li>
            <li><strong>Glitch-Free Scalable SVG:</strong> The QR code is rendered as high-contrast SVG, guaranteeing crisp edges on 4K monitors and Retina displays without blurring or pixelation.</li>
            <li><strong>One-Click QR Zoom Modal:</strong> Need to scan from across the room or let a coworker scan from their phone? Click the QR thumbnail to open an enlarged, high-visibility scan window with direct link copying.</li>
          </ul>
        </div>

        <div class="border-t border-slate-200 dark:border-slate-800 pt-8">
          <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">
            Engineered for Developers, Writers, and Multi-Device Power Users
          </h3>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
            Live Clipboard is specifically tuned to preserve textual integrity. Unlike chat apps that aggressively format, mangle, or auto-convert your text into previews, Live Clipboard preserves:
          </p>
          <div class="grid sm:grid-cols-2 gap-4 my-4 not-prose">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60">
              <h4 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">Code & Indentation</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400">Preserves indentation, tabs, spacing, curly braces, and code quotes for Python, JavaScript, HTML, JSON, and shell scripts.</p>
            </div>
