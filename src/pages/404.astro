---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found – Online Copy Paste"
  description="The page you requested could not be found. Return to Online Copy Paste to transfer text between devices."
>
  <main class="min-h-screen flex items-center justify-center px-6 py-16">
    <section class="w-full max-w-xl text-center rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-100 via-white to-amber-50 dark:from-[#111318] dark:via-[#07090d] dark:to-[#17120b] px-6 py-12 md:px-10 md:py-16">
      <p class="text-7xl font-extrabold tracking-tight text-amber-500">404</p>
      <h1 class="mt-5 text-3xl font-bold text-slate-900 dark:text-white">Page not found</h1>
      <p class="mt-4 text-slate-600 dark:text-slate-400">That page does not exist, but you can still transfer text between your devices.</p>
      <a href="/" class="mt-8 inline-flex items-center justify-center rounded-xl bg-amber-500 px-6 py-3 font-semibold text-slate-950 transition-colors hover:bg-amber-600">Go to Online Copy Paste</a>
    </section>
  </main>
</Layout>
