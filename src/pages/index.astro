---
import Layout from '../layouts/Layout.astro';
import ClipboardTool from '../components/ClipboardTool.astro';
import LanguagePicker from '../components/LanguagePicker.astro';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://onlinecopypaste.com').replace(/\/$/, '');

// Structured Data for SEO
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Online Copy Paste",
      "url": siteUrl,
      "description": "Online copy paste for transferring text between your phone, computer, and other devices with a temporary code and instant QR code.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is an online clipboard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An online clipboard is a web-based tool that temporarily stores text so you can access it from a different device, acting as a bridge between your phone, tablet, and computer."
          }
        },
        {
          "@type": "Question",
          "name": "How do I copy text from my PC to my phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paste your text into the tool on your PC to generate a 6-digit code and instant QR code. On your phone, simply scan the QR code with your camera or enter the 6-digit code on the website to retrieve and copy your text."
          }
        },
        {
          "@type": "Question",
          "name": "Can I transfer text by scanning a QR code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! When you generate a transfer code, a high-resolution QR code is automatically generated. Scan it using your iPhone or Android camera to open the link and retrieve your text immediately."
          }
        },
        {
          "@type": "Question",
          "name": "Can I share a direct link with the code included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Each generated transfer code has a direct link with the code parameter attached (?code=XXXXXX). Opening this link automatically retrieves and loads your text without needing to type the numbers."
          }
        }
      ]
    }
  ]
};
---

<Layout 
  title="Online Copy Paste – Transfer Text Between Devices with QR Code"
  description="Use online copy paste to transfer text between your phone, computer, and tablet with a temporary code or instant QR code. No app or account required."
  lang="en"
>
  <!-- Inject Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- HEADER -->
  <header class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center border-b border-slate-200 dark:border-slate-800">
    <a href="#top" class="inline-flex items-center gap-3 font-bold text-xl tracking-tight text-slate-900 dark:text-white" aria-label="Online Copy Paste home">
      <img src="/online-copy-paste-logo.svg" alt="" width="40" height="40" />
      <span class="hidden md:block">Online Copy Paste</span>
    </a>
    <nav class="flex items-center gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#how-it-works" class="hidden md:block hover:text-blue-600 dark:hover:text-blue-400 transition-colors">How It Works ?</a>
      <a href="#features" class="hidden md:block hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Features</a>
      <a href="#faq" class="hidden md:block hover:text-blue-600 dark:hover:text-blue-400 transition-colors">FAQ</a>
      <LanguagePicker />
      <button id="theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Toggle light and dark mode" class="inline-flex items-center justify-center p-2 rounded-lg border border-slate-300 bg-white text-slate-700 shadow-sm hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 transition-colors">
        <!-- Sun Icon (shows in dark mode) -->
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
        </svg>
        <!-- Moon Icon (shows in light mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-12 md:py-6">
    
    <!-- HERO SECTION -->
    <section class="text-center mb-10 rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-100 via-white to-amber-50 dark:from-[#111318] dark:via-[#07090d] dark:to-[#17120b] px-4 py-6 md:px-6 md:py-8" id="top">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3 tracking-tight text-slate-900 dark:text-white">Online Copy Paste Between Devices</h1>
      <p class="text-base text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Transfer text between your phone, computer, and tablet with a simple code or instant QR code. No app or account required.
      </p>

      <!-- MAIN TOOL COMPONENT -->
      <ClipboardTool />
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mt-24 pt-12 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-3xl font-bold text-center mb-12 text-slate-900 dark:text-white">How to Copy and Paste Between Devices</h2>
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-6">1</div>
          <h3 class="text-lg font-semibold mb-3 text-slate-900 dark:text-white">Paste Your Text</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Paste text, URLs, notes, or code snippets into the tool on your starting device.</p>
        </div>
        <div>
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-6">2</div>
          <h3 class="text-lg font-semibold mb-3 text-slate-900 dark:text-white">Get Code & QR Code</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Click Generate Code to instantly create a 6-digit retrieval code and scannable QR code.</p>
        </div>
        <div>
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-6">3</div>
          <h3 class="text-lg font-semibold mb-3 text-slate-900 dark:text-white">Scan or Enter Code</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Scan the QR code with your phone camera, or enter the 6-digit code on any device to copy your text.</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="mt-24">
      <h2 class="text-3xl font-bold text-center mb-12 text-slate-900 dark:text-white">Why Use Online Copy Paste?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Instant QR Code Pairing</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Transfer text from PC to mobile in one second. Simply point your smartphone camera at the generated QR code.</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Direct URL Link Sharing</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Every generated code includes a shareable link that automatically loads your text without typing a single digit.</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">No Account or Login</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Transfer text instantly without the friction of signing up, verifying an email, or remembering passwords.</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Universal Cross-Platform</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Works seamlessly across iPhone, Android, Windows, Mac, iPad, Linux, and Chromebook browsers.</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">No App Installation</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Runs 100% inside your browser. Save storage space and avoid granting unnecessary device permissions.</p>
        </div>
        <div class="p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Ephemeral Privacy</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm">All entries are temporary and automatically expire after 10 minutes or immediately upon retrieval.</p>
        </div>
      </div>
    </section>

    <!-- SEO CONTENT / USE CASES -->
    <section class="mt-24 max-w-3xl mx-auto prose prose-slate dark:prose-invert prose-lg">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 text-center">Transfer Text Between Devices Easily</h2>
      
      <p>We've all been there: you have a long, complicated URL on your laptop, and you urgently need to open it on your phone. Or maybe someone texted you an address or verification code, and you want to type it into a document on your computer. Online Copy Paste gives you a fast, reliable way to <strong>copy and paste between devices</strong> using only a standard web browser.</p>
      
      <p>Traditional methods often mean emailing notes to yourself, using messaging apps to send texts to a "Saved Messages" chat, or struggling with ecosystem barriers between Apple and Windows. Online Copy Paste eliminates those hurdles with a clean, lightweight web tool that pairs devices using a temporary 6-digit code or an <strong>instant QR code</strong>.</p>
      
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-5">How QR Code Text Transfer Works</h2>
      <p>Typing numbers on a smartphone keyboard can sometimes be cumbersome. That is why Online Copy Paste automatically generates a <strong>scannable QR code</strong> alongside every transfer code. Here is how simple the process is:</p>
      <ol class="list-decimal pl-6 mb-6 space-y-2">
        <li><strong>Paste your text:</strong> Enter your note, link, or snippet on your PC or laptop.</li>
        <li><strong>Generate the transfer:</strong> Click Generate Code to create a 6-digit code and a crisp QR code.</li>
        <li><strong>Scan with your phone camera:</strong> Open the native camera app on your iPhone or Android and point it at the QR code.</li>
        <li><strong>Copy the text:</strong> Tap the prompt on your phone screen to open the page. Your text is loaded immediately, ready to copy to your clipboard with a single tap.</li>
      </ol>

      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-5">Universal Cross-Device Compatibility</h2>
      <p>Unlike proprietary tools like Apple Universal Clipboard (which only works between Mac and iOS devices logged into the same Apple ID) or Microsoft Phone Link (which only connects specific Android devices to Windows), Online Copy Paste is completely platform-agnostic:</p>
      <ul class="list-disc pl-6 mb-6 space-y-2">
        <li><strong>PC to iPhone / Android:</strong> Send long links, passwords, and addresses from your desktop directly to your mobile device.</li>
        <li><strong>Phone to Mac / Windows:</strong> Transfer notes, draft emails, or texts typed on your smartphone to your computer for easy editing.</li>
        <li><strong>Mac to Windows / Linux:</strong> Move code snippets and commands between workstations without needing a shared network drive or chat software.</li>
      </ul>

      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-5">Privacy-First Architecture</h2>
      <p>Your privacy and security are paramount. Online Copy Paste is built on an ephemeral architecture designed for temporary transfers:</p>
      <ul class="list-disc pl-6 mb-6 space-y-2">
        <li><strong>Zero Account Tracking:</strong> No registration, no email address, and no cookies tracking your activity.</li>
        <li><strong>10-Minute Automatic Purge:</strong> Every generated code expires and becomes completely inaccessible after 10 minutes.</li>
        <li><strong>Direct One-Time Retrieval:</strong> Once text is retrieved, the record is immediately purged from the server.</li>
        <li><strong>HTTPS Encryption:</strong> All transfers take place over secure, encrypted SSL/TLS connections.</li>
      </ul>

      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-5">Supported Formats and Lengths</h2>
      <p>You can transfer up to <strong>20,000 characters</strong> per entry with full preservation of line breaks, whitespace, and special characters. This makes it ideal for transferring Markdown notes, JSON snippets, URLs with complex tracking parameters, multi-line street addresses, and source code.</p>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mt-24 max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-10 text-slate-900 dark:text-white">Frequently Asked Questions</h2>
      
      <div class="space-y-4">
        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            What is an online clipboard?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">An online clipboard is a web-based tool that temporarily stores text so you can access it from a different device. It acts as a bridge, allowing you to copy something on your phone and paste it on your computer, or vice versa, without needing any app or account.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            How do I copy text from my PC to my phone?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">Paste your text into the tool on your PC and click "Generate Code". A 6-digit code and a QR code will appear. On your phone, simply point your camera at the QR code, or open this website and enter the 6-digit code to copy your text instantly.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            How does the QR code transfer work?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">The QR code encodes a direct retrieval URL with your temporary code pre-filled. When you scan it using any modern smartphone camera, your mobile browser opens the page and automatically retrieves your text so you don't have to type anything.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            Can I share a direct URL link?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">Yes! When a code is generated, click "Copy Link" to copy the direct URL with ?code=XXXXXX. Anyone opening that link within 10 minutes will automatically load the text.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            Do I need an account or an app?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">No. You do not need to create an account, log in, provide an email address, or install any software. Everything runs entirely within standard web browsers.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            How long does a code last?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">Codes are strictly temporary and expire automatically 10 minutes after generation. Once expired or retrieved, the text is permanently deleted.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            What is the difference between this and Live Clipboard?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">Standard clipboard is designed for a one-time snapshot transfer with a 6-digit code or QR scan. Live Clipboard maintains a persistent real-time connection where edits on one screen sync automatically to your other screen as you type.</p>
        </details>

        <details class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-semibold cursor-pointer list-none text-slate-900 dark:text-white">
            Does it work between Windows, Mac, Android, and iPhone?
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">Yes. Because Online Copy Paste runs in any standard web browser, it works seamlessly across iOS, Android, Windows, macOS, Linux, and ChromeOS with no setup.</p>
        </details>
      </div>
    </section>n>

    <!-- FINAL CTA -->
    <section class="mt-32 mb-16 text-center">
      <div class="bg-blue-600 rounded-3xl p-10 md:p-16 max-w-4xl mx-auto shadow-2xl">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Need to move text to another device?</h2>
        <p class="text-blue-100 mb-8 text-lg">Paste it here, get a code, and copy it on your other device in seconds.</p>
        <a href="#top" class="inline-block bg-white text-blue-600 hover:bg-slate-100 font-bold py-4 px-8 rounded-xl transition-colors shadow-lg">
          Start Transferring Text
        </a>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 mt-20">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
        <div>
          <div class="inline-flex items-center gap-3 font-bold text-xl tracking-tight text-slate-900 dark:text-white mb-2">
            <img src="/online-copy-paste-logo.svg" alt="" width="40" height="40" />
            <span>Online Copy Paste</span>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-sm">A simple way to transfer text between your devices.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm font-medium text-slate-500 dark:text-slate-400">
          <a href="#top" class="hover:text-blue-600 dark:hover:text-blue-400">Home</a>
          <a href="#how-it-works" class="hover:text-blue-600 dark:hover:text-blue-400">How It Works</a>
          <a href="#faq" class="hover:text-blue-600 dark:hover:text-blue-400">FAQ</a>
          <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400">Privacy Policy</a>
          <a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400">Terms of Service</a>
          <a href="/contact" class="hover:text-blue-600 dark:hover:text-blue-400">Contact</a>
        </div>
      </div>
      <div class="mt-8 text-center text-slate-400 dark:text-slate-500 text-xs">
        &copy; {new Date().getFullYear()} Online Copy Paste. All rights reserved.
      </div>
      <LanguagePicker />
    </div>
  </footer>
</Layout>

<script is:inline>
  const initializeTheme = () => {
    const themeToggleBtn = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    if (!themeToggleBtn || !darkIcon || !lightIcon) return;

    // 1. Check current theme on load to show correct icon
    const currentTheme = localStorage.getItem('theme') || 
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    if (currentTheme === 'dark') {
      lightIcon.classList.remove('hidden');
      darkIcon.classList.add('hidden');
      document.documentElement.classList.add('dark');
    } else {
      darkIcon.classList.remove('hidden');
      lightIcon.classList.add('hidden');
      document.documentElement.classList.remove('dark');
    }

    // 2. Listen for button clicks
    themeToggleBtn.addEventListener('click', function() {
      const isDark = document.documentElement.classList.contains('dark');
      
      if (isDark) {
        // Switch to Light Mode
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        darkIcon.classList.remove('hidden');
        lightIcon.classList.add('hidden');
      } else {
        // Switch to Dark Mode
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        lightIcon.classList.remove('hidden');
        darkIcon.classList.add('hidden');
      }
    });

    // 3. Smooth scrolling for links (keeps your start button working)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if(targetId === '#') return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTheme, { once: true });
  } else {
    initializeTheme();
  }
</script>